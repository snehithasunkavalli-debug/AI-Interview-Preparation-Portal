# =====================================================================
# AI Interview Preparation Portal (Dossier) — Environment Configuration
# =====================================================================

# [MANDATORY IN PRODUCTION / VERCEL]
# Set a strong, unique secret key (minimum 16 characters) to sign session cookies.
# In local development, an insecure dev fallback is permitted if this is unset.
SECRET_KEY=generate_a_random_32_character_secret_key_here

# [ADMINISTRATOR PROVISIONING]
# In production / Vercel, the administrator account is ONLY created if ADMIN_PASSWORD is set.
# Default insecure passwords (like 'aiint') are permanently blocked in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_secure_admin_password_in_production
ADMIN_EMAIL=admin@dossier.portal

# [STORAGE & RUNTIME]
# On Vercel, STORAGE_DIR automatically defaults to /tmp/storage (the writable partition).
# For local Windows standalone development, defaults to ./storage
STORAGE_DIR=./storage
PORT=8080

# [OPTIONAL: PERSISTENT CLOUD DATABASE]
# SQLite in /tmp on Vercel is ephemeral (reset upon function restart).
# To persist accounts and interview records across serverless cold starts,
# connect an external PostgreSQL instance (such as Neon, Supabase, or Vercel Postgres):
# DATABASE_URL=postgresql://user:password@ep-host.neon.tech/neondb?sslmode=require

# [OPTIONAL: GEMINI AI LIVE INTERVIEW COACH]
# Add your Google Gemini API key to activate real-time AI mock interview questions:
GEMINI_API_KEY=
