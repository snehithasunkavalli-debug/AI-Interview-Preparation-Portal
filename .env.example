# =====================================================================
# AI Interview Preparation Portal (Dossier) — Environment Configuration
# =====================================================================

# [MANDATORY IN PRODUCTION / VERCEL]
# Set a strong, unique secret key (minimum 16 characters) to sign session cookies.
# In local development, an insecure dev fallback is permitted if this is unset.
SECRET_KEY=generate_a_random_32_character_secret_key_here

# [ADMINISTRATOR PROVISIONING]
# In production / Vercel, the administrator account is ONLY created if ADMIN_PASSWORD is set.
# Default insecure passwords are permanently blocked in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_secure_admin_password_in_production
ADMIN_EMAIL=admin@dossier.portal

# [MANDATORY IN PRODUCTION: PERSISTENT CLOUD DATABASE]
# On Vercel, serverless function storage (/tmp) is ephemeral and discarded
# across cold starts, causing data loss if SQLite is used.
# To ensure persistent user accounts, password hashes, and interview records,
# configure a PostgreSQL database (free tier on Neon or Supabase):
#
# Option A: Neon PostgreSQL (Recommended for serverless)
# DATABASE_URL=postgresql://user:password@ep-host.neon.tech/neondb?sslmode=require
#
# Option B: Supabase PostgreSQL (Direct connection or Transaction Pooler)
# DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres?sslmode=require
# (Or using transaction pooler on port 6543):
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
#
# For local Windows standalone development:
# If DATABASE_URL is unset, the portal safely defaults to persistent local disk storage (./storage/portal.db).
# In production/Vercel, ephemeral SQLite fallback is strictly blocked to prevent data loss.
DATABASE_URL=

# [STORAGE & RUNTIME]
# For local Windows standalone development, defaults to ./storage
# On Vercel, temporary PDF uploads use /tmp/storage/uploads
STORAGE_DIR=./storage
PORT=8080

# [OPTIONAL: GEMINI AI LIVE INTERVIEW COACH]
# Add your Google Gemini API key to activate real-time AI mock interview questions:
GEMINI_API_KEY=
